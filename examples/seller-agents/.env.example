# ─── Buyer (orchestrator / investment fund manager) ──────────────────────────
# Wallet that pays all seller agents. Needs Fuji USDC.
# Get test USDC: https://faucet.circle.com  (select Avalanche Fuji)
# Get test AVAX: https://core.app/tools/testnet-faucet/
CHAINPE_PRIVATE_KEY=0x...

# ─── Original demo sellers ────────────────────────────────────────────────────
RESEARCH_PAYTO=0x...
RESEARCH_PAYTO_KEY=0x...
DIGEST_PAYTO=0x...
DIGEST_PAYTO_KEY=0x...

# ─── Investment agents (NEW) ──────────────────────────────────────────────────
# Each needs its OWN wallet — ERC-8004 blocks self-feedback.
# Generate fresh wallets: node gen-wallets.mjs

# AVAX Price Agent — live AVAX price + DeFiLlama TVL (no LLM, $0.005/call)
PRICE_PAYTO=0x...
PRICE_PAYTO_KEY=0x...

# AVAX News Agent — Avalanche news + Claude synthesis ($0.02/call)
NEWS_PAYTO=0x...
NEWS_PAYTO_KEY=0x...

# AVAX Analysis Agent — Claude BUY/SELL/HOLD with price targets ($0.05/call)
ANALYSIS_PAYTO=0x...
ANALYSIS_PAYTO_KEY=0x...

# AVAX DEX Agent — Trader Joe Fuji swaps, simulation by default ($0.01/call)
# DEX_WALLET_KEY = the wallet that SIGNS the actual swap on Trader Joe (needs AVAX for gas)
DEX_PAYTO=0x...
DEX_PAYTO_KEY=0x...
DEX_WALLET_KEY=0x...

# ─── Shared ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Settlement facilitator: run in-process (key needs AVAX for gas)
# OR point at the hosted facilitator URL.
CHAINPE_FACILITATOR_KEY=0x...
# CHAINPE_FACILITATOR_URL=https://chainpe-facilitator-production.up.railway.app

# Network + deployed contracts (Fuji defaults)
CHAINPE_NETWORK=fuji
CHAINPE_REGISTRY_ADDRESS=0x91677a35599f052E99Ed0ab9E45c17E736a22Bf6
ERC8004_IDENTITY_REGISTRY=0x56FEc2359fcDfFa6FA1D3a8AB3b708Ff698161D5
ERC8004_REPUTATION_REGISTRY=0x89476DfEf9c72a668fa5E86f154B73EDB053aFe4

# ─── Ports / pricing (optional) ───────────────────────────────────────────────
RESEARCH_PROXY_PORT=4501
RESEARCH_BACKEND_PORT=5101
RESEARCH_PRICE=0.01
DIGEST_PROXY_PORT=4502
DIGEST_BACKEND_PORT=5102
DIGEST_PRICE=0.01
PRICE_PROXY_PORT=4503
PRICE_BACKEND_PORT=5103
PRICE_PRICE=0.005
NEWS_PROXY_PORT=4504
NEWS_BACKEND_PORT=5104
NEWS_PRICE=0.02
ANALYSIS_PROXY_PORT=4505
ANALYSIS_BACKEND_PORT=5105
ANALYSIS_PRICE=0.05
DEX_PROXY_PORT=4506
DEX_BACKEND_PORT=5106
DEX_PRICE=0.01

# ─── Portfolio seed (investment-orchestrator.mjs) ─────────────────────────────
# Simulated portfolio starting point — adjust to match your actual Fuji balances.
PORTFOLIO_USDC=10.0
PORTFOLIO_AVAX=0

# ─── Model overrides (optional) ───────────────────────────────────────────────
# RESEARCH_MODEL=claude-sonnet-4-6
# DIGEST_MODEL=claude-haiku-4-5-20251001
# NEWS_MODEL=claude-haiku-4-5-20251001
# ANALYSIS_MODEL=claude-sonnet-4-6
