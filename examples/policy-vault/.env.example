# Deployed PolicyVault (deploy with:
#   cd contracts && npm run deploy:policyvault:fuji)
VAULT_ADDRESS=0x...

# Three DISTINCT keys for the three roles.
OWNER_KEY=0x...      # funds the vault + sets policy (needs USDC + AVAX)
SESSION_KEY=0x...    # the agent's session signer (needs nothing — pays no gas)
RELAYER_KEY=0x...    # submits spends (needs AVAX for gas)

# Where spends go (e.g. a provider payTo).
RECIPIENT=0x...

# Network + token (defaults to Fuji).
CHAINPE_NETWORK=fuji
# USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# CHAINPE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
