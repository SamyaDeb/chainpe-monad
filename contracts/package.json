{
  "name": "@chainpe/contracts",
  "version": "2.0.0",
  "description": "ChainPe smart contracts for Monad: service registry + PolicyVault (UUPS), linked to the canonical ERC-8004 registries",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "lint:sol": "npx solhint 'contracts/**/*.sol'",
    "check-keys": "ts-node scripts/check-keys.ts",
    "preflight:testnet": "hardhat run scripts/preflight.ts --network monadTestnet",
    "preflight:mainnet": "hardhat run scripts/preflight.ts --network monad",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network monadTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network monad",
    "deploy:policyvault:testnet": "hardhat run scripts/deploy-policyvault.ts --network monadTestnet",
    "deploy:policyvault:mainnet": "hardhat run scripts/deploy-policyvault.ts --network monad",
    "deploy:timelock:testnet": "hardhat run scripts/deploy-timelock.ts --network monadTestnet",
    "deploy:timelock:mainnet": "hardhat run scripts/deploy-timelock.ts --network monad",
    "postcheck:testnet": "hardhat run scripts/postcheck.ts --network monadTestnet",
    "postcheck:mainnet": "hardhat run scripts/postcheck.ts --network monad",
    "verify:testnet": "hardhat run scripts/verify.ts --network monadTestnet",
    "verify:mainnet": "hardhat run scripts/verify.ts --network monad",
    "transfer-ownership:testnet": "hardhat run scripts/transfer-ownership.ts --network monadTestnet",
    "transfer-ownership:mainnet": "hardhat run scripts/transfer-ownership.ts --network monad",
    "node": "hardhat node"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "dotenv": "^16.5.0",
    "hardhat": "^2.22.17",
    "solc": "^0.8.28",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
