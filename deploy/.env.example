# ChainPe backend (deploy/docker-compose.yml) — copy to deploy/.env; never commit real keys.

# monad-testnet (default) | monad
NETWORK=monad-testnet
# Gas key for settlements (non-custodial: pays gas, relays signed payments only)
FACILITATOR_PRIVATE_KEY=
# Optional paid RPC (the public one caps eth_getLogs at ~100 blocks)
RPC_URL=
POSTGRES_PASSWORD=chainpe

# Mainnet only (testnet has SDK defaults) — from contracts/deployments/monad*.json:
CHAINPE_REGISTRY_ADDRESS=
START_BLOCK=
# PolicyVault proxy for mandate mode; leave empty on testnet for the deployed one, `off` to disable
POLICY_VAULT_ADDRESS=

# Facilitator payTo policy (mainnet is strict by default: registered payTo only)
PAYTO_ALLOWLIST=
REQUIRE_REGISTERED_PAYTO=
MIN_AMOUNT_ATOMIC=1000
ALLOWED_ORIGINS=
