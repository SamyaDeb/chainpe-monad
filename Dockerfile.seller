# Hosted demo seller (Railway): build context is the repo root.
#   RAILWAY_DOCKERFILE_PATH=Dockerfile.seller
FROM node:22-alpine
WORKDIR /app
COPY . .
RUN npm ci --workspace=@chainpemonad/sdk --workspace=@chainpemonad/cli --include-workspace-root=false \
 && npm run build -w @chainpemonad/sdk -w @chainpemonad/cli
ENV NODE_ENV=production
WORKDIR /app/examples/seller-agents
CMD ["node", "hosted-seller.mjs"]
