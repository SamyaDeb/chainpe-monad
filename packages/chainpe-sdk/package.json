{
  "name": "@chainpeavax/sdk",
  "version": "0.3.0-monad.0",
  "description": "ChainPe SDK for Monad — x402 USDC payments + payment-backed ERC-8004 reputation for AI agents.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.21",
    "@x402/express": "^2.28.0",
    "express": "^4.22.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "keywords": [
    "x402",
    "sdk",
    "usdc",
    "monad",
    "payments",
    "ai-agents",
    "erc-8004",
    "reputation",
    "chainpe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamyaDeb/chainpe-monad"
  },
  "engines": {
    "node": ">=18"
  }
}
