{
  "name": "@chainpemonad/agent",
  "version": "3.0.0-monad.0",
  "description": "ChainPe Agent \u2014 pre-built AI agent that discovers and pays for x402 v2 services in USDC on Monad",
  "type": "module",
  "bin": {
    "chainpe-agent": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamyaDeb/chainpe-monad.git",
    "directory": "packages/chainpe-agent"
  },
  "bugs": {
    "url": "https://github.com/SamyaDeb/chainpe-monad/issues"
  },
  "homepage": "https://github.com/SamyaDeb/chainpe-monad#readme",
  "author": "ChainPe",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "x402",
    "monad",
    "ai-agent",
    "sdk",
    "micropayments",
    "pay-per-request",
    "http-402",
    "usdc",
    "erc-8004",
    "vercel-ai-sdk",
    "openai",
    "anthropic",
    "qwen"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.70",
    "@ai-sdk/google": "^2.0.62",
    "@ai-sdk/openai": "^2.0.100",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@chainpemonad/sdk": "*",
    "@clack/prompts": "^0.9.1",
    "ai": "^6.0.116",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "gradient-string": "^3.0.0",
    "keytar": "^7.9.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "viem": "^2.57.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.15.21",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "express": "^4.22.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
