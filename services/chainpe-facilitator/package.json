{
  "name": "chainpe-facilitator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ChainPe x402 facilitator \u2014 non-custodial verify + settle service for USDC payments on Avalanche",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format esm --target node18 --clean",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "pino": "^9.6.0",
    "viem": "^2.21.0",
    "x402": "^1.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
