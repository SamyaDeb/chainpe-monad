# ChainPe facilitator (Monad) — copy to .env; never commit real keys.

# Gas-paying key that submits settlements. NON-CUSTODIAL: it only pays gas and
# relays the payer's signed authorization. Settlements send no MON value, so
# Monad's 10 MON reserve rule does not apply; ~137k gas per settlement.
FACILITATOR_PRIVATE_KEY=

# monad-testnet (default) | monad | local (any EVM chain; needs CHAIN_ID, RPC_URL, USDC_ADDRESS)
NETWORK=monad-testnet
# Optional RPC override (or MONAD_RPC_URL / MONAD_TESTNET_RPC_URL)
RPC_URL=

# Which payments we pay gas for:
# - payTo must be registered in the ChainPe registry (via the indexer) or listed here.
#   Strict by default on mainnet; set REQUIRE_REGISTERED_PAYTO=false for open dev use.
CHAINPE_INDEXER_URL=
PAYTO_ALLOWLIST=
REQUIRE_REGISTERED_PAYTO=
# Smallest payment we'll settle, in atomic USDC (1000 = 0.001 USDC)
MIN_AMOUNT_ATOMIC=1000

# HTTP
PORT=4500
# Comma-separated browser origins (default: none — server-to-server only)
ALLOWED_ORIGINS=
# Express trust-proxy hops (Railway: 1)
TRUST_PROXY=1
RATE_LIMIT_PER_MINUTE=120

# Warn below this many MON
LOW_GAS_MON=1
