{
  "name": "chainpe-indexer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ChainPe event indexer — watches the ChainPeRegistry + ERC-8004 Reputation contracts into Postgres and serves an O(1) discovery + reputation REST API.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format esm --target node18 --clean",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "pg": "^8.13.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.10",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
