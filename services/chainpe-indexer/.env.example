# ChainPe indexer — gitignored .env (never commit secrets)

# Postgres (Railway provides DATABASE_URL when you add a Postgres plugin).
DATABASE_URL=postgres://user:pass@host:5432/chainpe

# Network + contracts (defaults shown for Fuji).
NETWORK=fuji
# RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# CHAINPE_REGISTRY_ADDRESS=0x91677a35599f052E99Ed0ab9E45c17E736a22Bf6
# ERC8004_REPUTATION_REGISTRY=0x89476DfEf9c72a668fa5E86f154B73EDB053aFe4

# Indexing — START_BLOCK should be the registry deploy block (0 = from genesis,
# slow on public RPCs; set the deploy block for a fast cold start).
START_BLOCK=0
POLL_INTERVAL_MS=5000
LOG_CHUNK=2000

# HTTP port (Railway injects PORT automatically).
PORT=4600
