# ChainPe indexer — Monad
NETWORK=monad-testnet                 # or monad (mainnet, opt-in)
DATABASE_URL=postgres://user:pass@localhost:5432/chainpe_indexer
# RPC_URL=                            # default: MONAD_TESTNET_RPC_URL / MONAD_RPC_URL / public RPC
# CHAINPE_REGISTRY_ADDRESS=           # default on testnet: 0xe41CEcC51A61921dDFCeCAa9807856C446867CA4
# ERC8004_REPUTATION_REGISTRY=        # default: canonical registry for NETWORK
# ERC8004_IDENTITY_REGISTRY=          # default: canonical registry for NETWORK
# POLICY_VAULT_ADDRESS=              # Spent events of this vault count as payments (chainpe-vault);
#                                     default on testnet: 0x1Eb25cDD00bCCEC89782Aaf12600Ac5eFeEeAB65; `off` to disable
# START_BLOCK=                        # default on testnet: 69658414 (registry deploy block); REQUIRED on mainnet
LOG_CHUNK=100                         # Monad public RPC caps eth_getLogs at ~100 blocks
POLL_INTERVAL_MS=2000
MIN_PAID_AMOUNT=1000                  # atomic USDC (0.001) a receipt must carry to count
WEIGHT_CAP_AMOUNT=1000000             # atomic USDC (1.00): max weight of one receipt
PAYER_SHARE_CAP=0.25                  # max share of paid weight held by a single payer
TRUST_PROXY=1
PORT=4600
