# Network the dashboard reads (default fuji). Exposed to the browser for the
# register flow (chain id + contract addresses).
NEXT_PUBLIC_NETWORK=fuji

# Optional overrides (default to the deployed Fuji contracts).
# NEXT_PUBLIC_CHAINPE_REGISTRY_ADDRESS=0x91677a35599f052E99Ed0ab9E45c17E736a22Bf6
# NEXT_PUBLIC_ERC8004_REPUTATION_REGISTRY=0x89476DfEf9c72a668fa5E86f154B73EDB053aFe4

# Optional: point at a deployed indexer (Phase 4) for O(1) reads. When unset,
# the dashboard reads the registry + reputation directly on-chain via viem.
# INDEXER_URL=https://chainpe-indexer.example.com
