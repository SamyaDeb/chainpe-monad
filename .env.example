# ChainPe on Monad — environment template.
# Copy to .env and fill in. .env is gitignored; NEVER commit real keys.
# Network constants (chain ids, USDC, canonical ERC-8004) live in
# packages/chainpe-sdk/src/networks.ts — only override them here if needed.

# ─── Network ─────────────────────────────────────────────────────────────────
# monad-testnet (default) or monad
NETWORK=monad-testnet
# Optional RPC overrides (public defaults: rpc.monad.xyz / testnet-rpc.monad.xyz)
MONAD_RPC_URL=
MONAD_TESTNET_RPC_URL=

# ─── Contract deployment (contracts/) ───────────────────────────────────────
# Funded deployer key. Monad keeps a 10 MON reserve balance per account —
# fund comfortably above it.
DEPLOYER_PRIVATE_KEY=
# Owner of the deployed contracts (Safe / ChainPeTimelock). Required on mainnet
# unless ALLOW_DEPLOYER_OWNER=true.
OWNER_ADDRESS=
# Registration fee in USDC (default 0 — free listings).
REGISTRATION_FEE_USDC=0
# Treasury for fees (defaults to deployer).
FEE_RECIPIENT=
# Defaults to the canonical ERC-8004 IdentityRegistry for the network.
IDENTITY_REGISTRY=
# Etherscan v2 API key, used for Monadscan verification.
ETHERSCAN_API_KEY=

# ─── Deployed ChainPe contracts (fill in after deploying) ───────────────────
CHAINPE_REGISTRY_ADDRESS=
POLICY_VAULT_ADDRESS=
# ERC-8004 overrides (default: canonical Monad registries)
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=

# ─── Services ────────────────────────────────────────────────────────────────
# Facilitator gas key (pays settlement gas; holds no user funds)
FACILITATOR_PRIVATE_KEY=
# Where providers and agents send x402 verify/settle requests
CHAINPE_FACILITATOR_URL=
# Indexer
DATABASE_URL=
CHAINPE_INDEXER_URL=

# ─── Agents (SDK / MCP wallet / agent CLI) ──────────────────────────────────
CHAINPE_PRIVATE_KEY=
MAX_PER_CALL=0.10
MAX_PER_DAY=20.00
